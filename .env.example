# Server-only: never prefix these values with NEXT_PUBLIC_. Never commit .env.local.
# Supabase Connect > Transaction pooler URL. URL-encode the database password.
DATABASE_URL=
# Leave blank for verified TLS. Use 'disable' only for a local PostgreSQL test server.
DATABASE_SSL=
SUPABASE_URL=https://gyuwnxfllexbvzwwfbck.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=job-files
# Your final HTTPS Vercel URL or custom domain, without a trailing slash.
APP_URL=
# Leave both blank when importing your existing accounts.
# For a brand-new empty installation only: owner email + bcrypt temporary-password hash.
OWNER_LOGIN_EMAIL=
OWNER_BOOTSTRAP_PASSWORD_HASH=
# Optional invitation email delivery: Resend API key and verified sender address.
RESEND_API_KEY=
ACCOUNT_EMAIL_FROM=
# Generate a new web-push key pair for the new domain.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
